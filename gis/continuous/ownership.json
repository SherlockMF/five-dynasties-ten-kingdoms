      "role": "cross-check",
      "license": "史籍公版；现代编绘元数据",
      "redistributable": true
    },
    {
      "id": "chronology-south",
      "title": "南方政权与地方军镇年表",
      "reference": "《新五代史》卷61—69；《资治通鉴》卷282—292",
      "note": "国号、控制与名义臣属分开。闽、楚亡后的地方控制单列；小分区仅表达方向，不代表州界。",
      "role": "cross-check",
      "license": "史籍公版；现代编绘元数据",
      "redistributable": true
    },
    {
      "id": "chronology-song",
      "title": "宋初统一年表",
      "reference": "《宋史》卷1—5；《续资治通鉴长编》卷4、6、12、16—20",
      "note": "荆湖963、后蜀965、南汉971、南唐975、吴越978、北汉979；泉漳纳土978。",
      "role": "cross-check",
      "license": "史籍公版；现代编绘元数据",
      "redistributable": true
    },
    {
      "id": "chronology-qinfeng",
      "title": "后周取得秦凤成阶四州",
      "reference": "https://zh.wikisource.org/wiki/資治通鑑/卷292",
      "note": "955 年取秦、凤、成、阶，并非取整个汉中；汉中仍随蜀至965年。",
      "role": "cross-check",
      "license": "史籍公版；现代编绘元数据",
      "redistributable": true
    },
    {
      "id": "continuous-method",
      "title": "共享分区编绘方法",
      "reference": "gis/continuous/README.md",
      "note": "943总图固定地区母版，共享线段生成完整相邻分区；仅主要吞并割地改变归属，小范围进退不表现。周边是固定地域背景，非逐年国界。",
      "role": "cross-check",
      "license": "史籍公版；现代编绘元数据",
      "redistributable": true
    }
