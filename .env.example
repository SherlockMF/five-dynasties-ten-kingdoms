NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
LLM_PROVIDER=mock
LLM_API_KEY=server-only-provider-key
# 仅本地开发允许模型；生产环境强制关闭，问历史仍可使用本地资料。
# 本地两种对话模式均可调用模型；设置 LLM_PROVIDER=openai-compatible 后填写。
# 根地址应包含服务商要求的版本路径；程序会追加 /chat/completions。
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-chat-model

# Field：留空时 development=mock，production=disabled；部署前按模式重新构建。
# 可选 disabled / mock / webgl。生产显式 mock 仅用于受控联调。
NEXT_PUBLIC_HISTORY_FIELD_MODE=
# 仅 webgl 使用；未配置时不创建 iframe。本轮未部署 Unity。
NEXT_PUBLIC_HISTORY_FIELD_PLAYER_URL=
# 默认只准同源；未来 CDN 或本地独立 Player 按精确 origin 配置，逗号分隔。
# 示例 https://games.example.com,http://localhost:8080；不支持通配符或路径。
NEXT_PUBLIC_HISTORY_FIELD_ALLOWED_ORIGINS=
